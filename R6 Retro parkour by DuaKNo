-- ===================== ANIMATION ENGINE (smooth blends) =====================
local Eng = {
	cur = nil, fades = {}, attached = false, detached = {},
	animate = nil, animateWas = false, releasing = nil,
}

local function engKeep(C)
	for _, d in ipairs(C.hum:GetChildren()) do
		if d:IsA("Animator") then
			Eng.detached[#Eng.detached + 1] = d
			d.Parent = nil
		end
	end
end

function Eng.attach(C)
	Eng.releasing = nil
	if Eng.attached then return end
	Eng.attached = true
	Eng.animate = C.char:FindFirstChild("Animate")
	Eng.animateWas = Eng.animate ~= nil and Eng.animate.Disabled
	if Eng.animate then Eng.animate.Disabled = true end
	engKeep(C)
end

function Eng.restore(C)
	if not Eng.attached then return end
	Eng.attached = false
	Eng.cur = nil
	Eng.releasing = nil
	table.clear(Eng.fades)
	if C then
		for _, m in pairs(C.motors) do
			pcall(function() m.Transform = CFrame.new() end)
		end
		if C.hum and C.hum.Parent then
			for _, a in ipairs(C.hum:GetChildren()) do
				if a:IsA("Animator") then a:Destroy() end
			end
			for _, a in ipairs(Eng.detached) do
				if a.Parent == nil then a.Parent = C.hum end
			end
		end
		if Eng.animate and Eng.animate.Parent then Eng.animate.Disabled = Eng.animateWas end
	end
	Eng.detached = {}
	Eng.animate = nil
end

-- eases every joint back to the normal pose, then gives the game's animations back
function Eng.release(C, dur)
	if not Eng.attached or Eng.releasing then return end
	Eng.cur = nil
	for _, m in pairs(C.motors) do
		Eng.fades[m] = { from = m.Transform, t = 0, dur = dur }
	end
	Eng.releasing = os.clock() + dur + 0.03
end

function Eng.play(C, name, o)
	local anim = ANIM[name]
	if not anim then return false end
	o = o or {}
	Eng.attach(C)
	local from = {}
	for jn, m in pairs(C.motors) do
		from[jn] = m.Transform -- the pose you are in right now = where the blend starts
		Eng.fades[m] = nil
	end
	Eng.cur = {
		name = name, anim = anim, loop = o.loop or false, hold = o.hold or false,
		speed = o.speed or 1, elapsed = 0, index = 1,
		blendFrom = from, blendT = 0, blendDur = math.max(o.blend or 0.18, 0.01),
		base = o.base or false, done = false,
	}
	return true
end

-- base (looping / state) animation: keeps playing if it is already the right one
function Eng.base(C, name, o)
	if not ANIM[name] then return false end
	o = o or {}
	local cur = Eng.cur
	if cur and cur.base and cur.name == name then
		cur.speed = o.speed or 1
		return true
	end
	o.base = true
	return Eng.play(C, name, o)
end

function Eng.step(C, dt)
	if not Eng.attached then return end
	engKeep(C)
	if next(Eng.fades) ~= nil then
		for m, f in pairs(Eng.fades) do
			if not m.Parent then
				Eng.fades[m] = nil
			else
				f.t = f.t + dt
				m.Transform = f.from:Lerp(CFrame.new(), smooth(f.t / f.dur))
				if f.t >= f.dur then Eng.fades[m] = nil end
			end
		end
	end
	if Eng.releasing and os.clock() >= Eng.releasing then
		Eng.restore(C)
		return
	end
	local cur = Eng.cur
	if not cur then return end

	local anim = cur.anim
	local frames, times = anim.frames, anim.times
	local n = #frames
	local last = times[n]
	local seam = cur.loop and math.min(0.12, anim.total * 0.15) or 0

	local ba
	if cur.blendFrom then
		cur.blendT = cur.blendT + dt
		ba = smooth(cur.blendT / cur.blendDur)
		if cur.blendT >= cur.blendDur then cur.blendFrom = nil end
	end

	cur.elapsed = cur.elapsed + dt * cur.speed
	local bf = cur.blendFrom
	if cur.loop then
		if cur.elapsed >= last + seam then
			cur.elapsed = cur.elapsed - (last + seam)
			cur.index = 1
		end
	elseif cur.elapsed >= last then
		for jn, cf in pairs(frames[n].j) do
			local m = C.motors[jn]
			if m then
				if bf and bf[jn] then cf = bf[jn]:Lerp(cf, ba) end
				m.Transform = cf
			end
		end
		cur.done = true
		return
	end

	local t = cur.elapsed
	local i = cur.index
	if t < times[i] then i = 1 end
	while i < n and t >= times[i + 1] do i = i + 1 end
	cur.index = i

	local a = frames[i].j
	local b, alpha
	if i < n then
		b = frames[i + 1].j
		alpha = (t - times[i]) / math.max(times[i + 1] - times[i], 1e-6)
	else
		b = frames[1].j
		alpha = (t - times[n]) / math.max(seam, 1e-6)
	end
	alpha = math.clamp(alpha, 0, 1)
	for jn, cfA in pairs(a) do
		local m = C.motors[jn]
		if m then
			local cfB = b[jn]
			local cf = cfB and cfA:Lerp(cfB, alpha) or cfA
			if bf and bf[jn] then cf = bf[jn]:Lerp(cf, ba) end
			m.Transform = cf
		end
	end
end

-- ===================== CAMERA (FOV with speed + tilt) =====================
local Cam = { kick = 0, fov = nil, saved = nil, tilt = 0 }
local function camStep(dt)
	local camera = workspace.CurrentCamera
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not camera or not root then return end
	if CFG.fov then
		if not Cam.saved then
			Cam.saved = camera.FieldOfView
			Cam.fov = math.clamp(Cam.saved, CFG.fovMin, CFG.fovMax)
		end
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		Cam.kick = Cam.kick * math.exp(-5 * dt)
		local target = CFG.fovMin + (CFG.fovMax - CFG.fovMin) * math.clamp(speed / CFG.fovFull, 0, 1) + Cam.kick
		Cam.fov = Cam.fov + (target - Cam.fov) * (1 - math.exp(-CFG.fovSmooth * dt))
		camera.FieldOfView = math.clamp(Cam.fov, CFG.fovMin, CFG.fovMax + 10)
	end
	if CFG.tilt then
		local lateral = root.AssemblyLinearVelocity:Dot(camera.CFrame.RightVector)
		local target = math.clamp(lateral / 45, -1, 1) * CFG.tiltMax
		Cam.tilt = Cam.tilt + (target - Cam.tilt) * (1 - math.exp(-7 * dt))
		camera.CFrame = camera.CFrame * CFrame.Angles(0, 0, -Cam.tilt)
	end
end
pcall(function() RunService:UnbindFromRenderStep("DuaCam") end)
RunService:BindToRenderStep("DuaCam", Enum.RenderPriority.Camera.Value + 1, camStep)

-- ===================== PER CHARACTER =====================
local alive = true
local Active, ActiveCleanup = nil, nil

local function bindCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then
		warn("[Dua] no Humanoid / HumanoidRootPart found on your character")
		return nil
	end
	if hum.RigType ~= Enum.HumanoidRigType.R6 then -- the animations are R6
		warn("[Dua] your character is not R6, nothing started")
		return nil
	end
	local motors = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and JOINT[d.Name] and d.Part1 and not motors[d.Name] then
			motors[d.Name] = d
		end
	end
	if next(motors) == nil then
		warn("[Dua] no R6 joints found (reanimated / custom character?), nothing started")
		return nil
	end
	print("[Dua] character ready")

	local C = { char = char, hum = hum, root = root, motors = motors }
	local conns, dead = {}, false
	local function conn(c)
		conns[#conns + 1] = c
		return c
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char }
	rayParams.RespectCanCollide = true

	local attach = Instance.new("Attachment")
	attach.Name = "DuaAttach"
	attach.Parent = root
	local lv = Instance.new("LinearVelocity")
	lv.Name = "DuaVelocity"
	lv.Attachment0 = attach
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = math.huge
	lv.VectorVelocity = Vector3.zero
	lv.Enabled = false
	lv.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Name = "DuaAlign"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = attach
	ao.MaxTorque = math.huge
	ao.MaxAngularVelocity = math.huge
	ao.Responsiveness = 40
	ao.Enabled = false
	ao.Parent = root

	local S = {
		sliding = false, dashing = false, edge = nil, wall = false, action = nil,
		climbLock = 0, edgeLock = 0, wrunLock = 0, wrun = nil, pushTime = 0, jumpUntil = 0, jumpAt = 0, airJumps = 0,
		slideCd = 0, dashCd = 0, queuedSlide = 0, air = false, rollArmed = true,
		peakY = root.Position.Y,
		wwN = Vector3.zAxis, wwLook = Vector3.yAxis, wwSpeed = 0, wwStill = 0, wwLost = 0, wwLast = nil,
		slideDir = Vector3.zAxis, slideV0 = Vector3.zero, slideBase = 16, slideStart = 0, slideTime = 1.2,
		slideSpeedNow = 0, dashDir = Vector3.zAxis, dashV0 = Vector3.zero, dashStart = 0,
		dashLaunched = false, dashSpeedNow = 0,
	}
	local walkSpeedOrig = hum.WalkSpeed
	local curSpeed = CFG.startSpeed
	local speedOn = false
	pcall(function()
		hum.UseJumpPower = false
		hum.JumpHeight = JUMP.height or 7.2
	end)

	local function flatV()
		local v = root.AssemblyLinearVelocity
		return Vector3.new(v.X, 0, v.Z)
	end
	local function busy()
		return S.sliding or S.dashing or S.edge ~= nil or S.wall or S.wrun ~= nil
	end
	local function isCharacterPart(inst)
		local m = inst:FindFirstAncestorOfClass("Model")
		return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
	end
	local function wallHit(origin, dir, dist)
		local res = workspace:Raycast(origin, dir * dist, rayParams)
		if res and math.abs(res.Normal.Y) < 0.35 and not isCharacterPart(res.Instance) then
			return res
		end
		return nil
	end
	local function surfaceHit(origin, dir, dist)
		local res = workspace:Raycast(origin, dir * dist, rayParams)
		if res and not isCharacterPart(res.Instance) then return res end
		return nil
	end
	local function projectOn(v, n)
		return v - n * v:Dot(n)
	end
	local function aimDir()
		local md = hum.MoveDirection
		local f = Vector3.new(md.X, 0, md.Z)
		if f.Magnitude < 0.1 then f = flatV() end
		if f.Magnitude < 0.5 then
			local l = root.CFrame.LookVector
			f = Vector3.new(l.X, 0, l.Z)
		end
		if f.Magnitude < 0.1 then f = Vector3.zAxis end
		return f.Unit
	end
	local function playAction(name, o)
		if not ANIM[name] then return false end
		S.action = name
		return Eng.play(C, name, o or {})
	end
	local jumpSound -- filled in below
	local function playJump(now)
		S.jumpAt = now
		if jumpSound then
			jumpSound.TimePosition = 0
			jumpSound:Play()
		end
		if ANIM.jump then
			S.jumpUntil = now + ANIM.jump.total
			Eng.play(C, "jump", { base = true, hold = true, blend = 0.12 })
		end
	end

	local dashSound, slideSound, dashTrack -- filled in below (sounds + dash animation)
	-- ---------- SLIDE ----------
	local function endSlide(now, hop)
		if not S.sliding then return end
		S.sliding = false
		lv.Enabled = false
		ao.Enabled = false
		hum.PlatformStand = false
		hum.AutoRotate = true
		local d = S.slideDir
		local v = root.AssemblyLinearVelocity
		local keep = math.max(math.min(S.slideSpeedNow, math.max(curSpeed, 12)), 8)
		root.AssemblyLinearVelocity = Vector3.new(d.X * keep, v.Y, d.Z * keep)
		if hop then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end

	local function doSlide()
		local now = os.clock()
		if dead or S.sliding or S.edge or S.wall or S.dashing or hum.Sit or hum.Health <= 0 then return end
		if now < S.slideCd then return end
		if hum.FloorMaterial == Enum.Material.Air then
			S.queuedSlide = now + CFG.slideQueue -- slide as soon as you land
			return
		end
		local dir = aimDir()
		S.slideDir = dir
		S.slideV0 = flatV()
		S.slideBase = math.max(curSpeed, CFG.slideMin)
		S.slideSpeedNow = S.slideV0.Magnitude
		S.slideStart = now
		S.slideTime = (ANIM.slide and ANIM.slide.total or 1.3) * 0.92
		S.slideCd = now + CFG.slideCd
		S.sliding = true
		hum.PlatformStand = true
		hum.AutoRotate = false
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.xAxis
		lv.SecondaryTangentAxis = Vector3.zAxis
		lv.PlaneVelocity = Vector2.new(S.slideV0.X, S.slideV0.Z)
		lv.Enabled = true
		ao.CFrame = CFrame.lookAt(Vector3.zero, dir)
		ao.Enabled = true
		if slideSound then
			slideSound.TimePosition = 0
			slideSound:Play()
		end
		playAction("slide", { blend = CFG.readyBlend })
		Cam.kick = math.max(Cam.kick, 10)
	end

	local function updateSlide(now)
		local t = now - S.slideStart
		local d = S.slideDir
		local ready = smooth(t / CFG.readyTime) -- eases into the slide speed
		local life = math.clamp((t - CFG.readyTime) / math.max(S.slideTime - CFG.readyTime, 0.1), 0, 1)
		local decay = 1 - (1 - CFG.slideEnd) * life * life
		local target = d * (S.slideBase * CFG.slideBoost * decay)
		local vel = S.slideV0:Lerp(target, ready)
		S.slideSpeedNow = vel.Magnitude
		lv.PlaneVelocity = Vector2.new(vel.X, vel.Z)
		local blocked = workspace:Raycast(root.Position, d * 3, rayParams)
		if t >= S.slideTime
			or (t > 0.2 and blocked and not isCharacterPart(blocked.Instance) and math.abs(blocked.Normal.Y) < 0.5) then
			endSlide(now)
		end
	end

	-- ---------- DASH SOUND + REAL DASH ANIMATION ----------
	local function makeSfx(name, id, vol)
		if not id or id == "" then return nil end
		local snd = Instance.new("Sound")
		snd.Name = name
		snd.SoundId = id
		snd.Volume = vol or 1
		snd.RollOffMaxDistance = 200
		snd.Parent = root
		return snd
	end
	dashSound = makeSfx("DuaDashSfx", CFG.dashSoundId, CFG.dashSoundVolume)
	slideSound = makeSfx("DuaSlideSfx", CFG.slideSoundId, CFG.slideSoundVolume)
	jumpSound = makeSfx("DuaJumpSfx", CFG.jumpSoundId, CFG.jumpSoundVolume)
	local dashAnimObj
	if CFG.dashAnimId and CFG.dashAnimId ~= "" then
		dashAnimObj = Instance.new("Animation")
		dashAnimObj.Name = "DuaDashAnim"
		dashAnimObj.AnimationId = CFG.dashAnimId
	end
	-- preload everything now so the first slide / dash has no delay
	local dashAnimOk, warmDone = false, false
	do
		-- warm up the dash animation on a throw-away rig (the character's own Animator may not exist yet)
		local warmTrack, warmHolder
		if dashAnimObj then
			pcall(function()
				warmHolder = Instance.new("Model")
				warmHolder.Name = "DuaWarm"
				local ctrl = Instance.new("AnimationController")
				ctrl.Parent = warmHolder
				local an = Instance.new("Animator")
				an.Parent = ctrl
				warmHolder.Parent = workspace.CurrentCamera or workspace
				warmTrack = an:LoadAnimation(dashAnimObj)
			end)
		end
		task.spawn(function()
			local list = {}
			if dashSound then list[#list + 1] = dashSound end
			if slideSound then list[#list + 1] = slideSound end
			if jumpSound then list[#list + 1] = jumpSound end
			if dashAnimObj then list[#list + 1] = dashAnimObj end
			if #list > 0 then pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end) end
			if warmTrack then
				local t0 = os.clock()
				while warmTrack.Length == 0 and os.clock() - t0 < 8 and not dead do task.wait() end
				dashAnimOk = warmTrack.Length > 0
				pcall(function() warmTrack:Destroy() end)
				pcall(function() warmHolder:Destroy() end)
			else
				dashAnimOk = true -- could not test it, so just try it on the first dash
			end
			warmDone = true
		end)
	end

	local function stopDashTrack()
		local t = dashTrack
		dashTrack = nil
		if t then pcall(function() t:Stop(0) end) end
	end

	-- plays the dash animation asset; returns false if it cannot (then the built-in dash pose is used)
	local function startRealDash()
		if not dashAnimObj or (warmDone and not dashAnimOk) then return false end -- not loadable: built-in pose right away
		Eng.restore(C) -- gives the game's Animator back so a real animation can play
		S.action = nil
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		local ok, track = pcall(function() return animator:LoadAnimation(dashAnimObj) end)
		if not ok or not track then return false end
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = false
		track:Play(0)
		dashTrack = track
		task.spawn(function()
			local t0 = os.clock()
			while dashTrack == track and track.Length == 0 and os.clock() - t0 < 0.4 do task.wait() end
			if dashTrack ~= track or not S.dashing then return end
			if track.Length == 0 then -- asset did not load: use the built-in dash instead
				stopDashTrack()
				playAction("dash", { blend = CFG.readyBlend })
				return
			end
			if CFG.dashAnimFit then
				local total = CFG.dashReady + CFG.dashTime
				pcall(function() track:AdjustSpeed(math.clamp(track.Length / total, 0.5, 3)) end)
			end
		end)
		return true
	end

	-- ---------- DASH (air dash) ----------
	local function endDash(now)
		if not S.dashing then return end
		S.dashing = false
		stopDashTrack()
		lv.Enabled = false
		ao.Enabled = false
		hum.PlatformStand = false
		hum.AutoRotate = true
		local d = S.dashDir
		local v = root.AssemblyLinearVelocity
		local keep = math.min(S.dashSpeedNow, CFG.dashEndKeep)
		root.AssemblyLinearVelocity = Vector3.new(d.X * keep, v.Y, d.Z * keep)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end

	local function doDash()
		local now = os.clock()
		if dead or S.dashing or S.edge or S.wall or hum.Sit or hum.Health <= 0 then return end
		if now < S.dashCd then return end
		if S.sliding then endSlide(now) end
		local dir = aimDir()
		S.dashDir = dir
		S.dashV0 = flatV()
		S.dashSpeedNow = S.dashV0.Magnitude
		S.dashStart = now
		S.dashLaunched = false
		S.dashCd = now + CFG.dashCd
		S.dashing = true
		hum.PlatformStand = true
		hum.AutoRotate = false
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.xAxis
		lv.SecondaryTangentAxis = Vector3.zAxis
		lv.PlaneVelocity = Vector2.new(S.dashV0.X, S.dashV0.Z)
		lv.Enabled = true
		ao.CFrame = CFrame.lookAt(Vector3.zero, dir)
		ao.Enabled = true
		if dashSound then
			dashSound.TimePosition = 0
			dashSound:Play()
		end
		if not startRealDash() then playAction("dash", { blend = CFG.readyBlend }) end
	end

	local function updateDash(now)
		local t = now - S.dashStart
		local d = S.dashDir
		if t < CFG.dashReady then
			-- getting ready: keep your momentum while the dash pose blends in
			lv.PlaneVelocity = Vector2.new(S.dashV0.X, S.dashV0.Z)
			return
		end
		if not S.dashLaunched then
			S.dashLaunched = true
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, CFG.dashUp, v.Z) -- the jump
			Cam.kick = math.max(Cam.kick, 14)
		end
		local u = (t - CFG.dashReady) / CFG.dashTime
		if u >= 1 then
			endDash(now)
			return
		end
		local spd = CFG.dashSpeed * (1 - 0.45 * u * u)
		local ramp = smooth(u / 0.18)
		spd = S.dashV0.Magnitude + (spd - S.dashV0.Magnitude) * ramp
		S.dashSpeedNow = spd
		lv.PlaneVelocity = Vector2.new(d.X * spd, d.Z * spd)
	end

	-- ---------- EDGE CLIMB ----------
	local function findLedge(dirFlat)
		local res = wallHit(root.Position, dirFlat, CFG.edgeReach)
		if not res then res = wallHit(root.Position - Vector3.new(0, 1.4, 0), dirFlat, CFG.edgeReach) end
		if not res or dirFlat:Dot(-res.Normal) < 0.55 then return nil end
		local feetY = root.Position.Y - 3
		local topY = feetY + CFG.edgeMaxH + 2
		local o = Vector3.new(res.Position.X, topY, res.Position.Z) - res.Normal * 0.9
		local top = workspace:Raycast(o, Vector3.new(0, -(CFG.edgeMaxH + 3.5), 0), rayParams)
		if not top or top.Normal.Y < 0.7 or isCharacterPart(top.Instance) then return nil end
		local h = top.Position.Y - feetY
		if h < CFG.edgeMinH or h > CFG.edgeMaxH then return nil end
		if workspace:Raycast(top.Position + Vector3.new(0, 0.4, 0), Vector3.new(0, 5, 0), rayParams) then
			return nil
		end
		return res, top, h
	end

	local function endEdge(now)
		local e = S.edge
		if not e then return end
		S.edge = nil
		hum.PlatformStand = false
		hum.AutoRotate = true
		local carry = math.max(curSpeed * CFG.edgeCarry, 16)
		root.AssemblyLinearVelocity = Vector3.new(-e.n.X * carry, 0, -e.n.Z * carry)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		S.edgeLock = now + 0.25
		S.climbLock = now + 0.25
		S.air = false
	end

	local function startEdge(res, top, h, now)
		local n = Vector3.new(res.Normal.X, 0, res.Normal.Z).Unit
		local rise = math.clamp(h / CFG.edgeClimbSpeed, 0.18, 0.45)
		local e = {
			t0 = now, n = n, ready = CFG.edgeReady, rise = rise, over = CFG.edgeOver,
			p0 = root.Position,
			p1 = Vector3.new(res.Position.X + n.X * 1.3, top.Position.Y + 3.4, res.Position.Z + n.Z * 1.3),
			p2 = Vector3.new(top.Position.X - n.X * 0.6, top.Position.Y + 3.05, top.Position.Z - n.Z * 0.6),
		}
		S.edge = e
		hum.PlatformStand = true
		hum.AutoRotate = false
		root.AssemblyLinearVelocity = Vector3.zero
		local total = e.ready + e.rise + e.over
		local spd = ANIM.edge and math.clamp(ANIM.edge.total / total, 0.5, 1.3) or 1
		playAction("edge", { blend = e.ready + 0.1, speed = spd })
		Cam.kick = math.max(Cam.kick, 6)
	end

	local function updateEdge(now)
		local e = S.edge
		local t = now - e.t0
		local pos
		if t < e.ready then
			pos = e.p0 -- get ready: grab, the pose blends in
		elseif t < e.ready + e.rise then
			local u = (t - e.ready) / e.rise
			pos = e.p0:Lerp(e.p1, 1 - (1 - u) ^ 3)
		elseif t < e.ready + e.rise + e.over then
			pos = e.p1:Lerp(e.p2, smooth((t - e.ready - e.rise) / e.over))
		else
			endEdge(now)
			return
		end
		root.CFrame = CFrame.lookAt(pos, pos - e.n)
		root.AssemblyLinearVelocity = Vector3.zero
	end

	-- ---------- WALL WALK / WALL CLIMB / CEILING WALK ----------
	local function wwCFrame()
		return CFrame.fromMatrix(Vector3.zero, S.wwLook:Cross(S.wwN), S.wwN, -S.wwLook)
	end

	local function startWallWalk(normal)
		S.wall = true
		S.wwN = normal.Unit
		local up = projectOn(Vector3.yAxis, S.wwN)
		if up.Magnitude > 0.1 then
			S.wwLook = up.Unit
		else
			local f = projectOn(root.CFrame.LookVector, S.wwN)
			S.wwLook = f.Magnitude > 0.05 and f.Unit or projectOn(Vector3.zAxis, S.wwN).Unit
		end
		S.wwSpeed, S.wwStill, S.wwLost, S.wwLast = 0, 0, 0, nil
		hum.PlatformStand = true
		hum.AutoRotate = false
		root.AssemblyLinearVelocity = Vector3.zero
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.VectorVelocity = Vector3.zero
		lv.Enabled = true
		ao.CFrame = wwCFrame()
		ao.Enabled = true
		S.jumpUntil = 0
		Cam.kick = math.max(Cam.kick, 5)
	end

	local function endWallWalk(now)
		S.wall = false
		lv.Enabled = false
		ao.Enabled = false
		local face = Vector3.new(S.wwLook.X, 0, S.wwLook.Z)
		if face.Magnitude < 0.4 then face = Vector3.new(-S.wwN.X, 0, -S.wwN.Z) end
		if face.Magnitude < 0.1 then face = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z) end
		if face.Magnitude < 0.1 then face = Vector3.zAxis end
		face = face.Unit
		local pos = root.Position + Vector3.new(0, 1, 0)
		root.CFrame = CFrame.lookAt(pos, pos + face)
		root.AssemblyLinearVelocity = Vector3.zero
		hum.PlatformStand = false
		hum.AutoRotate = true
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		S.climbLock = now + 0.35
		S.air = false
	end

	local function wwFind(pos, dir, surfUp, rightV)
		local reach = CFG.wwDist + 2.5
		local r = surfaceHit(pos, dir, reach)
		if r then return r end
		local offs = { surfUp * 1.6, -surfUp * 1.6, rightV * 1.6, -rightV * 1.6 }
		for _, o in ipairs(offs) do
			r = surfaceHit(pos + o, dir, reach + 1)
			if r and r.Normal:Dot(S.wwN) > 0.5 then return r end
		end
		return nil
	end

	local function updateWallWalk(now, dt)
		local pos = root.Position
		local dir = -S.wwN
		local surfUp = projectOn(Vector3.yAxis, S.wwN)
		surfUp = surfUp.Magnitude > 0.2 and surfUp.Unit or S.wwLook
		local rightV = dir:Cross(surfUp)
		local move = hum.MoveDirection
		local vIn, hIn = 0, 0
		if move.Magnitude > 0.1 then
			local tw = Vector3.new(dir.X, 0, dir.Z)
			if tw.Magnitude > 0.1 then vIn = move:Dot(tw.Unit) end
			hIn = move:Dot(rightV)
		end
		local along = surfUp * vIn + rightV * hIn
		if math.abs(S.wwN.Y) > 0.7 then along = Vector3.new(move.X, 0, move.Z) end
		local mag = math.min(along.Magnitude, 1)
		local alongDir = mag > 0.15 and along.Unit or nil
		local want = alongDir and CFG.wallWalkSpeed * mag or 0
		S.wwSpeed = S.wwSpeed + (want - S.wwSpeed) * (1 - math.exp(-9 * dt))

		local res = wwFind(pos, dir, surfUp, rightV)
		local usedGrace = false

		-- wall meets a ceiling: keep going on the ceiling
		if alongDir and S.wwSpeed > 1 and alongDir.Y > 0.3 and math.abs(S.wwN.Y) < 0.5 then
			local upHit = surfaceHit(pos, Vector3.yAxis, CFG.wwCeilCatch)
			if not upHit then upHit = surfaceHit(pos + dir * 1.5, Vector3.yAxis, CFG.wwCeilCatch) end
			if upHit and upHit.Normal.Y < -0.8 then
				local away = Vector3.new(S.wwN.X, 0, S.wwN.Z)
				S.wwN = upHit.Normal.Unit
				res = upHit
				dir = -S.wwN
				if away.Magnitude > 0.1 then
					alongDir = away.Unit
					S.wwLook = alongDir
				end
			end
		end

		-- a new surface in front: turn the corner
		if alongDir and S.wwSpeed > 1 then
			local reachA = CFG.wwDist + ((alongDir.Y > 0.3) and 2.2 or 0.6)
			local ahead = surfaceHit(pos, alongDir, reachA)
			if ahead and ahead.Normal:Dot(S.wwN) < 0.75 then
				if ahead.Normal.Y > 0.8 then
					if alongDir.Y < -0.25 then
						endWallWalk(now)
						return
					end
				else
					local oldN = S.wwN
					S.wwN = ahead.Normal.Unit
					res = ahead
					dir = -S.wwN
					if S.wwN.Y < -0.8 and math.abs(oldN.Y) < 0.5 then
						local away = Vector3.new(oldN.X, 0, oldN.Z)
						if away.Magnitude > 0.1 then
							alongDir = away.Unit
							S.wwLook = alongDir
						end
					else
						alongDir = projectOn(alongDir, S.wwN)
						alongDir = alongDir.Magnitude > 0.1 and alongDir.Unit or nil
					end
				end
			end
		end

		if not res then
			local wrapped
			if alongDir and S.wwSpeed > 1 then
				local p2 = pos + alongDir * 3.5 + dir * (CFG.wwDist + 0.5)
				local h = surfaceHit(p2, -alongDir, 5)
				if h and math.abs(h.Normal.Y) < 0.8 then wrapped = h end
			end
			if wrapped then
				S.wwN = wrapped.Normal.Unit
				res = wrapped
				dir = -S.wwN
				if alongDir then
					alongDir = projectOn(alongDir, S.wwN)
					alongDir = alongDir.Magnitude > 0.1 and alongDir.Unit or nil
				end
			else
				local goingUp = alongDir ~= nil and alongDir.Y > 0.5
				S.wwLost = S.wwLost + dt
				if S.wwLast and S.wwLost <= (goingUp and 0.1 or CFG.wwGrace) then
					res = S.wwLast
					usedGrace = true
				else
					local flatIn = Vector3.new(dir.X, 0, dir.Z)
					flatIn = flatIn.Magnitude > 0.1 and flatIn.Unit or Vector3.zero
					endWallWalk(now)
					if goingUp then
						-- reached the top: climb over the edge
						root.AssemblyLinearVelocity = flatIn * CFG.mantleForward + Vector3.new(0, CFG.mantleUp, 0)
						if CFG.edge then playAction("edge", { blend = 0.14, speed = 1.1 }) end
					end
					return
				end
			end
		end
		if not usedGrace then
			S.wwLost = 0
			S.wwLast = res
		end

		local err = (res.Position - pos):Dot(dir) - CFG.wwDist
		local alongVel = alongDir and (alongDir * S.wwSpeed) or Vector3.zero
		lv.VectorVelocity = alongVel + dir * math.clamp(err * 20, -22, 22)

		if alongDir then
			local target = projectOn(alongDir, S.wwN)
			if target.Magnitude > 0.05 then
				S.wwLook = S.wwLook:Lerp(target.Unit, 1 - math.exp(-14 * dt))
			end
		end
		local keep = projectOn(S.wwLook, S.wwN)
		if keep.Magnitude < 0.05 then
			keep = projectOn(Vector3.yAxis, S.wwN)
			if keep.Magnitude < 0.05 then keep = projectOn(Vector3.zAxis, S.wwN) end
		end
		S.wwLook = keep.Unit
		ao.CFrame = wwCFrame()

		if alongDir == nil and S.wwSpeed < 1.5 then
			S.wwStill = S.wwStill + dt
		else
			S.wwStill = 0
		end
	end

	local function doWallWalkJump(now)
		local n = S.wwN
		local alongPush = S.wwSpeed > 2 and S.wwLook * CFG.wwJumpAlong or Vector3.zero
		local launch = n * CFG.wallJumpOut + alongPush + Vector3.new(0, CFG.wallJumpUp, 0)
		if math.abs(n.Y) > 0.7 then launch = alongPush + n * 10 end
		Cam.kick = math.max(Cam.kick, 8)
		endWallWalk(now)
		S.climbLock = now + 0.12
		local flat = Vector3.new(launch.X, 0, launch.Z)
		if flat.Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
		end
		root.AssemblyLinearVelocity = launch
		S.airJumps = 0
		playJump(now)
	end

	local function tryStartClimb(state, dt, now)
		if not (CFG.wallWalk or CFG.ceiling or CFG.edge) then return end
		if now < S.climbLock or now < S.edgeLock
			or state == Enum.HumanoidStateType.Climbing
			or state == Enum.HumanoidStateType.Swimming
			or state == Enum.HumanoidStateType.Seated or hum.Sit then
			S.pushTime = 0
			return
		end
		if CFG.ceiling and (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall) then
			if root.AssemblyLinearVelocity.Y > 4 then
				local up = workspace:Raycast(root.Position, Vector3.new(0, CFG.ceilingReach, 0), rayParams)
				if up and up.Normal.Y < -0.8 and not isCharacterPart(up.Instance) then
					S.pushTime = 0
					startWallWalk(up.Normal)
					return
				end
			end
		end
		local md = hum.MoveDirection
		local flat = Vector3.new(md.X, 0, md.Z)
		if flat.Magnitude < 0.1 then
			S.pushTime = 0
			return
		end
		flat = flat.Unit
		local res = wallHit(root.Position, flat, CFG.climbReach)
		if not res and CFG.edge then
			res = wallHit(root.Position - Vector3.new(0, 1.4, 0), flat, CFG.climbReach + 0.5)
		end
		if res and flat:Dot(-res.Normal) > 0.6 then
			S.pushTime = S.pushTime + dt
			if CFG.edge and S.pushTime >= CFG.edgeDelay then
				local lres, ltop, lh = findLedge(flat)
				if lres then
					S.pushTime = 0
					startEdge(lres, ltop, lh, now)
					return
				end
			end
			if S.pushTime >= CFG.climbStartDelay then
				S.pushTime = 0
				if CFG.wallWalk then startWallWalk(res.Normal) end
			end
		else
			S.pushTime = 0
		end
	end

	-- ---------- WALL RUN ----------
	local function endWallRun(now, jumpOff)
		local w = S.wrun
		if not w then return end
		S.wrun = nil
		lv.Enabled = false
		ao.Enabled = false
		hum.PlatformStand = false
		hum.AutoRotate = true
		local v = root.AssemblyLinearVelocity
		if jumpOff then
			local out = w.n * CFG.wrunJumpOut + w.along * (w.speed * 0.85) + Vector3.new(0, CFG.wrunJumpUp, 0)
			local flat = Vector3.new(out.X, 0, out.Z)
			if flat.Magnitude > 0.1 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
			end
			root.AssemblyLinearVelocity = out
			S.airJumps = 0 -- you can double jump again after a wall run jump
			Cam.kick = math.max(Cam.kick, 9)
		else
			root.AssemblyLinearVelocity = w.along * (w.speed * 0.8) + Vector3.new(0, math.min(v.Y, 0), 0)
		end
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		S.wrunLock = now + CFG.wrunCd
		S.climbLock = now + 0.2
		if jumpOff then playJump(now) end
	end

	local function startWallRun(res, v, now)
		local n = Vector3.new(res.Normal.X, 0, res.Normal.Z)
		if n.Magnitude < 0.1 then return end
		n = n.Unit
		local along = v - n * v:Dot(n)
		if along.Magnitude < 0.1 then return end
		along = along.Unit
		S.wrun = {
			n = n, along = along, t0 = now, lost = 0,
			speed = math.max(flatV().Magnitude, CFG.wrunSpeed),
			vy0 = math.max(root.AssemblyLinearVelocity.Y, CFG.wrunUp),
		}
		hum.PlatformStand = true
		hum.AutoRotate = false
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.VectorVelocity = along * S.wrun.speed + Vector3.new(0, S.wrun.vy0, 0)
		lv.Enabled = true
		ao.CFrame = CFrame.lookAt(Vector3.zero, along)
		ao.Enabled = true
		S.airJumps = 0
		S.jumpUntil = 0
		Cam.kick = math.max(Cam.kick, 7)
	end

	local function updateWallRun(now, dt)
		local w = S.wrun
		local t = now - w.t0
		local pos = root.Position
		local hit = workspace:Raycast(pos, -w.n * (CFG.wrunReach + 0.8), rayParams)
		local ok = hit ~= nil and math.abs(hit.Normal.Y) < 0.35 and not isCharacterPart(hit.Instance)
		if ok then
			w.lost = 0
			w.n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z).Unit
		else
			w.lost = w.lost + dt
		end
		local a = w.along - w.n * w.along:Dot(w.n) -- follow curved walls
		if a.Magnitude > 0.1 then w.along = a.Unit end
		local u = math.clamp(t / CFG.wrunTime, 0, 1)
		local vy = w.vy0 * (1 - u) - 8 * u
		local ground = workspace:Raycast(pos, Vector3.new(0, -3.4, 0), rayParams)
		if u >= 1 or w.lost > 0.18 or hum.MoveDirection.Magnitude < 0.1
			or (t > 0.2 and vy < 0 and ground ~= nil and not isCharacterPart(ground.Instance)) then
			endWallRun(now, false)
			return
		end
		local stick = Vector3.zero
		if ok then
			local d = (pos - hit.Position):Dot(w.n)
			stick = -w.n * math.clamp((d - 1.9) * 12, -8, 8)
		end
		lv.VectorVelocity = w.along * (w.speed * (1 - 0.12 * u)) + Vector3.new(0, vy, 0) + stick
		ao.CFrame = CFrame.lookAt(Vector3.zero, w.along)
	end

	local function tryStartWallRun(state, now)
		if not CFG.wallRun or busy() or now < S.wrunLock or now < S.climbLock or hum.Sit then return end
		if hum.FloorMaterial ~= Enum.Material.Air or now - S.jumpAt < 0.08 then return end
		local md = hum.MoveDirection
		local flat = Vector3.new(md.X, 0, md.Z)
		if flat.Magnitude < 0.1 then return end
		flat = flat.Unit
		local fv = flatV()
		if fv.Magnitude < CFG.wrunMinSpeed then return end
		local v = fv.Unit
		if flat:Dot(v) < 0.5 then return end
		-- a wall straight ahead is for the edge climb / wall climb, not the wall run
		if wallHit(root.Position, flat, CFG.climbReach) then return end
		local right = Vector3.new(-v.Z, 0, v.X)
		for _, side in ipairs({ right, -right }) do
			local res = wallHit(root.Position, side, CFG.wrunReach)
			if res and math.abs(res.Normal:Dot(v)) < 0.5 then
				startWallRun(res, v, now)
				return
			end
		end
	end

	-- ---------- JUMP (Roblox's own jump button / space) ----------
	local lastJumpCall = 0
	local function doJump()
		local now = os.clock()
		if dead or hum.Health <= 0 then return end
		if now - lastJumpCall < 0.08 then return end -- the same press can arrive twice
		lastJumpCall = now
		if S.wrun then
			endWallRun(now, true)
			return
		end
		if S.wall then
			doWallWalkJump(now)
			return
		end
		if S.sliding then
			endSlide(now, true)
			playJump(now)
			return
		end
		if S.edge or S.dashing then return end
		if now - S.jumpAt < 0.2 then return end
		if hum.FloorMaterial ~= Enum.Material.Air then
			S.airJumps = 0
		elseif S.airJumps < (JUMP.extra or 0) then
			S.airJumps = S.airJumps + 1
			S.doubleJumped = true -- landing after this always plays the roll
			local power = math.sqrt(2 * workspace.Gravity * (JUMP.airHeight or JUMP.height or 7.2))
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
		else
			return
		end
		playJump(now)
	end

	-- the jump button on some devices only flips Humanoid.Jump, so listen to that too
	conn(hum:GetPropertyChangedSignal("Jump"):Connect(function()
		if hum.Jump then doJump() end
	end))

	-- ---------- SPEED BUILD-UP (parkour) ----------
	local function speedStep(dt)
		if not CFG.speedOn then
			if speedOn then
				speedOn = false
				hum.WalkSpeed = walkSpeedOrig
			end
			return
		end
		if busy() then return end
		if not speedOn then
			speedOn = true
			curSpeed = CFG.startSpeed
			hum.WalkSpeed = curSpeed
		end
		local start = CFG.startSpeed
		local moving = hum.MoveDirection.Magnitude > 0.1
		local rate = (CFG.maxSpeed - start) / math.clamp(CFG.rampTime, 0.2, 8)
		local desired = moving and CFG.maxSpeed or start
		if curSpeed < desired then
			curSpeed = math.min(desired, curSpeed + rate * dt)
		elseif curSpeed > desired then
			local step = moving and math.huge or rate * CFG.stopDecay * dt
			curSpeed = math.max(desired, curSpeed - step)
		end
		hum.WalkSpeed = curSpeed
	end

	-- ---------- BASE ANIMATION (idle / walk / run / jump / fall / wall) ----------
	local function locoName(ratio)
		if ANIM.sprint ~= ANIM.run and ratio > 0.9 then return "sprint" end
		if ANIM.walk ~= ANIM.run and ratio < 0.375 then return "walk" end
		return "run"
	end

	local function chooseBase(now)
		if S.action or S.sliding or S.dashing or S.edge then S.idleSince = nil return end
		local animSpd = JOY.animSpeed or 1
		local idleNow = false
		local ok = true
		if S.wrun then
			ok = Eng.base(C, "run", {
				loop = true, blend = 0.15,
				speed = math.clamp(S.wrun.speed / CFG.runBase, 1, CFG.maxRunAnim) * animSpd,
			})
		elseif S.wall then
			if S.wwStill >= CFG.wallIdleDelay and ANIM.idle then
				ok = Eng.base(C, "idle", { loop = true, blend = 0.25, speed = (JOY.idleSpeed or 1) * animSpd })
			else
				ok = Eng.base(C, "run", {
					loop = true, blend = 0.2, speed = math.clamp(S.wwSpeed / CFG.runBase, 0.8, 2.4) * animSpd,
				})
			end
		else
			local v = root.AssemblyLinearVelocity
			local flat = Vector3.new(v.X, 0, v.Z).Magnitude
			local grounded = hum.FloorMaterial ~= Enum.Material.Air
			local cur = Eng.cur
			if not grounded then
				if now < S.jumpUntil and ANIM.jump then
					Eng.base(C, "jump", { hold = true, blend = 0.12 })
					return
				end
				if v.Y < -8 and ANIM.fall then
					Eng.base(C, "fall", { loop = true, blend = 0.2 })
					return
				end
				if cur and cur.base and (cur.name == "jump" or cur.name == "fall") then return end
			end
			if hum.MoveDirection.Magnitude > 0.1 then
				ok = Eng.base(C, locoName(flat / CFG.maxSpeed), {
					loop = true, blend = 0.2,
					speed = math.clamp(math.max(flat, 4) / CFG.runBase, 0.6, CFG.maxRunAnim) * animSpd,
				})
			else
				ok = Eng.base(C, "idle", { loop = true, blend = 0.25, speed = (JOY.idleSpeed or 1) * animSpd })
				if grounded and flat < 3 then idleNow = true end
			end
		end
		-- standing still for a while: sometimes play the special idle once
		if idleNow and CFG.idleAlt and ANIM.idleAlt then
			if not S.idleSince then
				S.idleSince = now
				S.idleNext = now + CFG.idleAltMin + math.random() * math.max(CFG.idleAltMax - CFG.idleAltMin, 0)
			elseif now >= S.idleNext then
				S.idleSince = nil
				playAction("idleAlt", { blend = 0.25, speed = CFG.idleAltSpeed })
				return
			end
		else
			S.idleSince = nil
		end
		if not ok then Eng.release(C, 0.15) end
	end

	-- ---------- MAIN LOOP ----------
	conn(RunService.Heartbeat:Connect(function(dt)
		if dead then return end
		if hum.Health <= 0 or not root.Parent then return end
		local now = os.clock()
		local state = hum:GetState()

		-- seated / swimming / ladder: hand the character back to the game
		if not busy() and (hum.Sit or state == Enum.HumanoidStateType.Seated
			or state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Climbing) then
			Eng.release(C, 0.15)
			Eng.step(C, dt)
			return
		end

		if S.sliding then updateSlide(now) end
		if S.dashing then updateDash(now) end
		if S.edge then updateEdge(now) end
		if S.wrun then updateWallRun(now, dt) end
		if S.wall then
			updateWallWalk(now, dt)
		elseif not busy() then
			tryStartClimb(state, dt, now)
		end
		if not busy() then tryStartWallRun(state, now) end

		if S.queuedSlide > now and not busy() and hum.FloorMaterial ~= Enum.Material.Air then
			S.queuedSlide = 0
			S.slideCd = 0
			doSlide()
		end

		speedStep(dt)

		-- fall roll: from a high place, the roll pose is ready right before you touch the ground
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		if busy() then S.doubleJumped = false end -- wall / edge / dash / slide took over
		if grounded then
			if S.doubleJumped then -- landed after a double jump and the roll did not start in the air yet
				S.doubleJumped = false
				if CFG.roll and ANIM.roll and S.rollArmed and S.action == nil and not busy() then
					S.rollArmed = false
					playAction("roll", { blend = 0.12 })
					Cam.kick = math.max(Cam.kick, 8)
				end
			end
			S.air = false
			S.airJumps = 0
			S.rollArmed = true
		elseif not busy() then
			if not S.air then
				S.air = true
				S.peakY = root.Position.Y
			end
			if root.Position.Y > S.peakY then S.peakY = root.Position.Y end
			local vy = root.AssemblyLinearVelocity.Y
			if CFG.roll and ANIM.roll and S.rollArmed and S.action == nil and (S.doubleJumped and vy < -2 or vy < -CFG.rollMinFall) then
				local g = workspace:Raycast(root.Position, Vector3.new(0, -(math.abs(vy) * CFG.rollLead + 3.2), 0), rayParams)
				if g and not isCharacterPart(g.Instance) and (S.doubleJumped or (S.peakY - g.Position.Y) >= CFG.rollMinDrop) then
					S.rollArmed = false
					S.doubleJumped = false
					playAction("roll", { blend = 0.16 })
					Cam.kick = math.max(Cam.kick, 8)
				end
			end
		end

		-- slide / dash is over: a wall climb or wall run takes over, so the run / climb animation plays
		if (S.action == "slide" or S.action == "dash") and not S.sliding and not S.dashing and (S.wall or S.wrun) then
			S.action = nil
		end
		if dashTrack and not S.dashing then stopDashTrack() end
		if S.action == "idleAlt" and (hum.MoveDirection.Magnitude > 0.1 or hum.FloorMaterial == Enum.Material.Air or busy()) then
			S.action = nil -- you moved / jumped: normal animations take over
		end

		-- an action is over once its animation finished and nothing physical is left
		if S.action then
			local c = Eng.cur
			if not c or c.name ~= S.action or (c.done and not busy()) then S.action = nil end
		end

		chooseBase(now)
		Eng.step(C, dt)
	end))

	local function cleanup()
		if dead then return end
		dead = true
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		pcall(function() lv:Destroy() end)
		pcall(function() ao:Destroy() end)
		pcall(function() attach:Destroy() end)
		stopDashTrack()
		pcall(function() if dashSound then dashSound:Destroy() end end)
		pcall(function() if slideSound then slideSound:Destroy() end end)
		pcall(function() if jumpSound then jumpSound:Destroy() end end)
		pcall(function() if dashAnimObj then dashAnimObj:Destroy() end end)
		pcall(function() Eng.restore(C) end)
		pcall(function()
			hum.PlatformStand = false
			hum.AutoRotate = true
			hum.WalkSpeed = walkSpeedOrig
		end)
	end
	conn(hum.Died:Connect(cleanup))

	return { slide = doSlide, dash = doDash, jump = doJump, cleanup = cleanup }
end

-- ===================== BUTTONS (ContextActionService) =====================
local casNames, gconns = {}, {}
local fb = nil -- backup buttons (if ever drawn)
local buttonsOn = false

local function bindAct(name, title, key, fn)
	local keys = key and { key } or {}
	local ok = pcall(function()
		CAS:BindAction(name, function(_, state)
			if state == Enum.UserInputState.Begin then fn() end
			return Enum.ContextActionResult.Sink
		end, true, table.unpack(keys))
	end)
	if ok then
		casNames[#casNames + 1] = name
		pcall(function() CAS:SetTitle(name, title) end)
	end
end

local function bindButtons()
	if buttonsOn then return end
	buttonsOn = true
	bindAct("DuaSlide", "SLIDE", Enum.KeyCode.C, function()
		if Active then Active.slide() end
	end)
	bindAct("DuaDash", "DASH", Enum.KeyCode.Q, function()
		if Active then Active.dash() end
	end)
end

-- R15 (or anything that is not R6): the buttons and their keys go away
local function unbindButtons()
	if not buttonsOn then return end
	buttonsOn = false
	for _, n in ipairs(casNames) do pcall(function() CAS:UnbindAction(n) end) end
	table.clear(casNames)
	if fb then
		pcall(function() fb:Destroy() end)
		fb = nil
	end
end

-- big buttons placed left of Roblox's own jump button: slide next to it, dash above slide
local function layoutButtons()
	local sb, db = CAS:GetButton("DuaSlide"), CAS:GetButton("DuaDash")
	if not sb or not db then return false end
	local parent = sb.Parent
	local sg = sb:FindFirstAncestorOfClass("ScreenGui")
	if not parent or not sg then return false end
	local sgPos, sgSize = sg.AbsolutePosition, sg.AbsoluteSize
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	local tg = pg and pg:FindFirstChild("TouchGui")
	local jump = tg and tg:FindFirstChild("JumpButton", true)
	local jx, jy, jw, jh
	if jump and jump:IsA("GuiObject") and jump.AbsoluteSize.X > 0 then
		jx, jy = jump.AbsolutePosition.X, jump.AbsolutePosition.Y
		jw, jh = jump.AbsoluteSize.X, jump.AbsoluteSize.Y
	else
		jw, jh = 110, 110
		jx = sgPos.X + sgSize.X - 25 - jw
		jy = sgPos.Y + sgSize.Y - 25 - jh
	end
	local size = CFG.btnSize
	local right = jx - CFG.btnGap
	local bottom = jy + jh
	local pAbs = parent.AbsolutePosition
	local spots = { { sb, right, bottom }, { db, right, bottom - size - CFG.btnGap } }
	for _, s in ipairs(spots) do
		local b = s[1]
		b.AnchorPoint = Vector2.new(1, 1)
		b.Size = UDim2.fromOffset(size, size)
		b.Position = UDim2.fromOffset(
			math.max(s[2], sgPos.X + size + 8) - pAbs.X,
			math.max(s[3], sgPos.Y + size + 8) - pAbs.Y
		)
		b.Visible = true
	end
	return true
end

-- safety net: only if Roblox never creates the touch buttons, draw two round ones
local function makeFallback()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DuaButtons"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	local parent
	if gethui then
		local okH, h = pcall(gethui)
		if okH and typeof(h) == "Instance" then parent = h end
	end
	gui.Parent = parent or lp:WaitForChild("PlayerGui")
	local size = CFG.btnSize
	local function mk(text, yOff, fn)
		local b = Instance.new("TextButton")
		b.AnchorPoint = Vector2.new(1, 1)
		b.Position = UDim2.new(1, -150, 1, yOff)
		b.Size = UDim2.fromOffset(size, size)
		b.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
		b.BackgroundTransparency = 0.25
		b.BorderSizePixel = 0
		b.Text = text
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold
		b.TextSize = 18
		b.AutoButtonColor = false
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(1, 0)
		cr.Parent = b
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(1, 1, 1)
		st.Transparency = 0.6
		st.Thickness = 2
		st.Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				fn()
			end
		end)
		b.Parent = gui
	end
	mk("SLIDE", -30, function() if Active then Active.slide() end end)
	mk("DASH", -30 - size - CFG.btnGap, function() if Active then Active.dash() end end)
	return gui
end

task.spawn(function()
	local tries = 0
	while alive do
		local ok, placed = false, false
		if buttonsOn then ok, placed = pcall(layoutButtons) end
		if not buttonsOn then
			tries = 0
		elseif ok and placed then
			tries = 0
			if fb then
				pcall(function() fb:Destroy() end)
				fb = nil
			end
		else
			tries = tries + 1
			if tries == 8 then warn("[Dua] Roblox touch buttons did not appear, drawing backup buttons") end
			if tries >= 8 and UIS.TouchEnabled and not fb then
				local okF, g = pcall(makeFallback)
				if okF then fb = g end
			end
		end
		task.wait(0.5)
	end
end)

-- ===================== WIRING =====================
gconns[#gconns + 1] = UIS.JumpRequest:Connect(function()
	if Active then Active.jump() end
end)

local function onChar(char)
	if ActiveCleanup then
		pcall(ActiveCleanup)
		ActiveCleanup = nil
		Active = nil
	end
	task.spawn(function()
		local api = bindCharacter(char)
		if api and lp.Character == char then
			Active, ActiveCleanup = api, api.cleanup
			bindButtons()
		elseif api then
			pcall(api.cleanup)
		elseif lp.Character == char then
			unbindButtons() -- not R6: no buttons
		end
	end)
end
gconns[#gconns + 1] = lp.CharacterAdded:Connect(onChar)
if lp.Character then onChar(lp.Character) end

-- type !clear in chat: removes the script, the buttons and the whole system
local clearing = false
local function checkChat(text)
	if clearing or type(text) ~= "string" then return end
	local t = text:lower():gsub("%s+", "")
	if t ~= "!clear" then return end
	clearing = true
	if env.__DuaDesignStop then pcall(env.__DuaDesignStop) end
	sysMsg("Script cleared. Run it again to bring it back.")
end
gconns[#gconns + 1] = lp.Chatted:Connect(checkChat)
pcall(function()
	gconns[#gconns + 1] = TextChatService.MessageReceived:Connect(function(msg)
		if msg.TextSource and msg.TextSource.UserId == lp.UserId then checkChat(msg.Text) end
	end)
end)

env.__DuaDesignStop = function()
	alive = false
	pcall(unbindButtons)
	for _, n in ipairs(casNames) do pcall(function() CAS:UnbindAction(n) end) end
	for _, c in ipairs(gconns) do pcall(function() c:Disconnect() end) end
	pcall(function() RunService:UnbindFromRenderStep("DuaCam") end)
	if ActiveCleanup then pcall(ActiveCleanup) end
	if fb then pcall(function() fb:Destroy() end) end
	local camera = workspace.CurrentCamera
	if camera and Cam.saved then pcall(function() camera.FieldOfView = Cam.saved end) end
	env.__DuaDesignStop = nil
end
