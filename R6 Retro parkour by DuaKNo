local C = CFrame.new
local function pose(rs, ls, rh, lh, nk, rj)
	return {
		["Right Shoulder"] = rs, ["Left Shoulder"] = ls, ["Right Hip"] = rh,
		["Left Hip"] = lh, ["Neck"] = nk, ["RootJoint"] = rj,
	}
end
local function mk(seq) -- { {dt, pose}, ... }
	local frames, times, t = {}, {}, 0
	for i, e in ipairs(seq) do
		t = t + e[1]
		frames[i] = { dt = e[1], j = e[2] }
		times[i] = t
	end
	return { frames = frames, times = times, total = math.max(t, 0.05) }
end

